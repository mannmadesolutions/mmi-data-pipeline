{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["jquery"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/ui/**/*.ts", "tests/ui/**/*.tsx"]
}
