{
	"manifest_version": 3,
	"name": "MMI Product Data",
	"version": "0.10.3",
	"description": "Work on a maker's product page for your store: see what it gives each product, write it, pick parts and pictures on the page.",
	"minimum_chrome_version": "116",
	"permissions": [
		"storage",
		"scripting",
		"activeTab",
		"alarms"
	],
	"optional_host_permissions": [
		"https://*/*",
		"http://*/*"
	],
	"background": {
		"service_worker": "sw.js"
	},
	"action": {
		"default_title": "MMI Product Data",
		"default_icon": {
			"16": "icons/16.png",
			"32": "icons/32.png"
		}
	},
	"options_ui": {
		"page": "connect.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	}
}
