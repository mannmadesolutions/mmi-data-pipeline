{
	"manifest_version": 3,
	"name": "MannMade",
	"version": "1.3.0",
	"description": "Connects Chrome to your own store's MMI tools, to work on supplier and maker web pages for that store.",
	"minimum_chrome_version": "116",
	"permissions": [
		"storage",
		"scripting",
		"activeTab",
		"alarms"
	],
	"optional_host_permissions": [
		"https://*/*",
		"http://*/*"
	],
	"background": {
		"service_worker": "sw.js"
	},
	"action": {
		"default_title": "MannMade",
		"default_icon": {
			"16": "icons/16.png",
			"32": "icons/32.png"
		}
	},
	"options_ui": {
		"page": "connect.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	}
}
